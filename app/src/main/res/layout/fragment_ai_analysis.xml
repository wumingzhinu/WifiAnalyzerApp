<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF0D1117">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📊 文件概览" android:textSize="16sp" android:textColor="#FFE6EDF3" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvFileOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8B949E" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔍 结构分析" android:textSize="16sp" android:textColor="#FFE6EDF3" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvStructureAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF58A6FF" android:fontFamily="monospace" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🤖 AI分析" android:textSize="16sp" android:textColor="#FFE6EDF3" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvAiConclusion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8B949E"/>
    </LinearLayout>
</ScrollView>
