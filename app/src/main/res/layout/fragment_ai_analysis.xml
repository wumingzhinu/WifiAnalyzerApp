<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="文件概览"
            android:textSize="16sp"
            android:textColor="#FFE6EDF3"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFileOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFC9D1D9"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="握手包详情"
            android:textSize="16sp"
            android:textColor="#FFE6EDF3"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHandshakeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF58A6FF"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="安全分析"
            android:textSize="16sp"
            android:textColor="#FFE6EDF3"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSecurityAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFF5722"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="破解可行性"
            android:textSize="16sp"
            android:textColor="#FFE6EDF3"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCrackableInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF3FB950"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="建议"
            android:textSize="16sp"
            android:textColor="#FFE6EDF3"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRecommendations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFC9D1D9"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
